<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="sensor_kit_macro" params="parent x y z roll pitch yaw">
    <xacro:include filename="$(find ugv_a_sensor_kit_description)/sensor/airy/urdf/airy.urdf.xacro"/>
    <xacro:include filename="$(find ugv_a_sensor_kit_description)/sensor/camera/urdf/d435i_camera.xacro"/>
    <xacro:include filename="$(find ugv_a_sensor_kit_description)/sensor/imu/urdf/imu.xacro"/>

    <xacro:arg name="gpu" default="false"/>
    <xacro:arg name="config_dir" default="$(find ugv_a_sensor_kit_description)/config"/>

    <xacro:property name="sensor_kit_base_link" default="sensor_kit_base_link"/>

    <joint name="${sensor_kit_base_link}_joint" type="fixed">
      <origin rpy="${roll} ${pitch} ${yaw}" xyz="${x} ${y} ${z}"/>
      <parent link="${parent}"/>
      <child link="${sensor_kit_base_link}"/>
    </joint>
    <link name="${sensor_kit_base_link}">
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </link>

    <!-- sensor -->
    <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/sensor_kit_calibration.yaml')}"/>

    <!-- lidar -->
    <xacro:Airy parent="sensor_kit_base_link" name="rs_airy_top" topic="/points_raw" hz="10" gpu="$(arg gpu)">
      <origin
        xyz="${calibration['sensor_kit_base_link']['rs_airy_top_base_link']['x']}
             ${calibration['sensor_kit_base_link']['rs_airy_top_base_link']['y']}
             ${calibration['sensor_kit_base_link']['rs_airy_top_base_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['rs_airy_top_base_link']['roll']}
             ${calibration['sensor_kit_base_link']['rs_airy_top_base_link']['pitch']}
             ${calibration['sensor_kit_base_link']['rs_airy_top_base_link']['yaw']}"
      />
    </xacro:Airy>

    <!-- camera -->
    <xacro:d435i_camera_macro
      name="d435i/camera"
      parent="sensor_kit_base_link"
      namespace=""
      x="${calibration['sensor_kit_base_link']['d435i/camera_link']['x']}"
      y="${calibration['sensor_kit_base_link']['d435i/camera_link']['y']}"
      z="${calibration['sensor_kit_base_link']['d435i/camera_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['d435i/camera_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['d435i/camera_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['d435i/camera_link']['yaw']}"
      fps="30"
      width="800"
      height="400"
      fov="1.3"
    />

    <!-- imu -->
    <xacro:imu_macro
      name="rs_airy/imu"
      parent="sensor_kit_base_link"
      namespace=""
      x="${calibration['sensor_kit_base_link']['rs_airy/imu_link']['x']}"
      y="${calibration['sensor_kit_base_link']['rs_airy/imu_link']['y']}"
      z="${calibration['sensor_kit_base_link']['rs_airy/imu_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['rs_airy/imu_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['rs_airy/imu_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['rs_airy/imu_link']['yaw']}"
      fps="100"
    />
  </xacro:macro>
</robot>
