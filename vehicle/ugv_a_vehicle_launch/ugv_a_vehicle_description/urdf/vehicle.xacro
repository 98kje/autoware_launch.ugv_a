<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- load parameter -->
  <xacro:property name="vehicle_info" value="${xacro.load_yaml('$(find ugv_a_vehicle_description)/config/vehicle_info.param.yaml')}"/>

  <!-- vehicle body -->
  <link name="base_link">
    <!-- body - mesh origin is the top surface, deck height 0.345 -->
    <visual>
      <origin xyz="0 0 0.345" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ugv_a_vehicle_description/mesh/ranger_base.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <!-- front left wheel -->
    <visual>
      <origin xyz="${vehicle_info['/**']['ros__parameters']['wheel_base']} ${vehicle_info['/**']['ros__parameters']['wheel_tread']/2.0} ${vehicle_info['/**']['ros__parameters']['wheel_radius']}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ugv_a_vehicle_description/mesh/wheel_v3.dae" scale="14.1 10.6 14.1"/>
      </geometry>
    </visual>
    <!-- front right wheel -->
    <visual>
      <origin xyz="${vehicle_info['/**']['ros__parameters']['wheel_base']} ${-vehicle_info['/**']['ros__parameters']['wheel_tread']/2.0} ${vehicle_info['/**']['ros__parameters']['wheel_radius']}" rpy="0 0 ${pi}"/>
      <geometry>
        <mesh filename="package://ugv_a_vehicle_description/mesh/wheel_v3.dae" scale="14.1 10.6 14.1"/>
      </geometry>
    </visual>
    <!-- rear left wheel -->
    <visual>
      <origin xyz="${-vehicle_info['/**']['ros__parameters']['wheel_base']} ${vehicle_info['/**']['ros__parameters']['wheel_tread']/2.0} ${vehicle_info['/**']['ros__parameters']['wheel_radius']}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ugv_a_vehicle_description/mesh/wheel_v3.dae" scale="14.1 10.6 14.1"/>
      </geometry>
    </visual>
    <!-- rear right wheel -->
    <visual>
      <origin xyz="${-vehicle_info['/**']['ros__parameters']['wheel_base']} ${-vehicle_info['/**']['ros__parameters']['wheel_tread']/2.0} ${vehicle_info['/**']['ros__parameters']['wheel_radius']}" rpy="0 0 ${pi}"/>
      <geometry>
        <mesh filename="package://ugv_a_vehicle_description/mesh/wheel_v3.dae" scale="14.1 10.6 14.1"/>
      </geometry>
    </visual>
  </link>
</robot>